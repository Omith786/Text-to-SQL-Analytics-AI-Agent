# Copy to .env and adjust. All variables are optional; the defaults target a
# local Ollama server, which is free and needs no account.

# OpenAI-compatible chat endpoint. Ollama exposes one at /v1.
T2SQL_BASE_URL=http://localhost:11434/v1

# API key. Ignored by Ollama, but the client requires a non-empty value.
# For a hosted free-tier gateway, put its key here instead.
T2SQL_API_KEY=ollama

# Model name as known to the endpoint.
# Local examples: qwen2.5:1.5b, qwen2.5:3b, llama3.1:8b
T2SQL_MODEL=qwen2.5:1.5b

# Sampling temperature. 0.0 is best for deterministic SQL generation.
T2SQL_TEMPERATURE=0.0

# Per-request timeout in seconds for the LLM call.
T2SQL_TIMEOUT=120

# Agent and SQL sandbox limits.
T2SQL_MAX_RETRIES=3
T2SQL_ROW_LIMIT=1000
T2SQL_SQL_TIMEOUT=10

# --- Example: Groq free tier (OpenAI-compatible) ---
# T2SQL_BASE_URL=https://api.groq.com/openai/v1
# T2SQL_API_KEY=your-groq-key
# T2SQL_MODEL=llama-3.1-8b-instant
